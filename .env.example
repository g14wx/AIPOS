# Copia este archivo a .env y cambia los valores. El .env no va a git.
# Las claves que empiezan con "cambiar-" son de ejemplo: pon las tuyas.

# Docker Compose: el nombre del proyecto separa contenedores y volúmenes de dos copias del repo.
COMPOSE_PROJECT_NAME=aipos

# Backend
PORT=3000
# Origen de la pantalla, con esquema y puerto y sin barra final. Varios, separados por coma. Nunca *.
CORS_ORIGIN=http://localhost:5173

# MySQL. MYSQL_PORT es el puerto del host; dentro de Docker MySQL siempre usa el 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aipos
MYSQL_TEST_DATABASE=aipos_prueba
MYSQL_USER=aipos
MYSQL_PASSWORD=cambiar-esta-clave
# Solo la usan Docker Compose y el script que crea la base de prueba. La API nunca entra como root.
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-de-root

# Frontend (Vite solo deja pasar al navegador lo que empieza con VITE_)
FRONTEND_PORT=5173
# Dirección del backend, sin /api al final.
VITE_API_URL=http://localhost:3000
