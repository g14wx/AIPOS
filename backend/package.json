{
  "name": "aipos-backend",
  "version": "0.1.0",
  "description": "API de AIPOS: Node.js, Express y Sequelize",
  "private": true,
  "main": "src/servidor.js",
  "engines": {
    "node": ">=24"
  },
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "node --watch src/servidor.js",
    "start": "node src/servidor.js",
    "test": "vitest run",
    "test:vigilar": "vitest",
    "migrar": "sequelize-cli db:migrate",
    "deshacer": "sequelize-cli db:migrate:undo",
    "rehacer": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "migrar:prueba": "sequelize-cli db:migrate --env test",
    "deshacer:prueba": "sequelize-cli db:migrate:undo --env test",
    "rehacer:prueba": "sequelize-cli db:migrate:undo:all --env test && sequelize-cli db:migrate --env test",
    "preparar-prueba": "node scripts/crear-base-de-prueba.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mysql2": "3.24.5",
    "sequelize": "6.37.8",
    "sequelize-cli": "6.6.5",
    "swagger-ui-dist": "5.33.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "vitest": "5.0.2"
  }
}
