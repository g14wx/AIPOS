MM&lt;/b&gt; en cada paso." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="42" y="264" width="191" height="180" as="geometry"/></mxCell><mxCell id="c10" value="Trello MCP" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;fontColor=#1a73e8;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="195" height="26" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eef4fe;strokeColor=#1a73e8;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="285" y="150" width="215" height="330" as="geometry"/></mxCell><mxCell id="c12" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="297" y="162" width="34" height="34" as="geometry"/></mxCell><mxCell id="c13" value="Orquestador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#1f2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337" y="158" width="155" height="44" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="365" y="208" width="54" height="54" as="geometry"/></mxCell><mxCell id="c15" value="Claude Code (Opus) lee la tarjeta, consulta el &lt;b&gt;grafo del proyecto&lt;/b&gt; y reparte el trabajo a agentes en segundo plano." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="297" y="264" width="191" height="180" as="geometry"/></mxCell><mxCell id="c16" value="Graphify" style="rounded=1;arcSize=40;whiteSpace=w