    "@vue/test-utils": "1.3.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1",
    "vue-template-compiler": "2.7.16"
