{
  "name": "aipos-frontend",
  "version": "0.1.0",
  "description": "Pantalla de AIPOS: Vue 2, Vuetify 2 y Vite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
