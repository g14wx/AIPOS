        <mxCell id="leyenda" value="Leyenda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="330" height="140" as="geometry" /></mxCell>
        <mxCell id="ley-0" value="→ Flujo normal" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="leyenda"><mxGeometry x="10" y="26" width="310" height="20" as="geometry" /></mxCell>
        <mxCell id="ley-1" value="→ Camino de error" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;" vertex="1" parent="leyenda"><mxGeometry x="10" y="48" width="310" height="20" as="geometry" /></mxCell>
        <mxCell id="ley-2" value="┈ Nota" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#999999;" vertex="1" parent="leyenda"><mxGeometry x="10" y="70" width="310" height="20" as="geometry" /></mxCell>
        <mxCell id="notas" value="&lt;b&gt;La persona decide&lt;/b&gt;: aprueba la spec y valida el código y las pruebas; el PDF la hace responsable del resultado.&lt;br&gt;&lt;b&gt;Spec&lt;/b&gt;: si la tarjeta cambia código, no se implementa sin la spec aprobada en specs/ (tile spec-driven-development).&lt;br&gt;&lt;b&gt;Grafo del proyecto&lt;/b&gt;: el agente lo consulta antes de reunir requisitos, y el hook de git «pre-commit» lo actualiza en cada commit.&lt;br&gt;&lt;b&gt;A la bitácora de IA&lt;/b&gt; va cada corrección y cada propuesta descartada (salen los puntos 8 a 11 del README).&lt;br&gt;&lt;b&gt;Palabra nueva&lt;/b&gt;: si aparece una palabra del negocio que no está en el glosario, el agente para, pregunta y propone la entrada.&lt;br&gt;&lt;b&gt;Commit&lt;/b&gt;: Conventional Commits en español, Co-Authored-By y sin Claude-Session. &lt;b&gt;Detalle&lt;/b&gt;: requerimientos/flujos/06-trabajar-una-tarjeta-con-el-agente.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="640" width="2410" height="140" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
